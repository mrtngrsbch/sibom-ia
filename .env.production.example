# =============================================================================
# .env.production.example — Variables de entorno para producción
# Copiar a .env y rellenar los valores reales en el VPS
# NUNCA commitear el archivo .env con valores reales
# =============================================================================

# ── API Keys (requeridas) ─────────────────────────────────────────────────────

# OpenRouter (LLM principal del chatbot RAG)
# Obtener en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (embeddings)
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (opcional, si se usa Claude directamente)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ── Qdrant Vector DB ──────────────────────────────────────────────────────────
# Si usas Qdrant local (docker-compose), usar URL interna:
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ── Configuración de modelos LLM ──────────────────────────────────────────────
# Modelos disponibles en OpenRouter: https://openrouter.ai/models
LLM_MODEL_PRIMARY=anthropic/claude-3.5-sonnet
LLM_MODEL_ECONOMIC=anthropic/claude-3-haiku
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Configuración de datos ────────────────────────────────────────────────────
# Usar índice de normativas completo (true) o minimal (false)
USE_NORMATIVAS_INDEX=false
# Usar SQLite para almacenamiento local
USE_SQLITE=false

# ── Sat Analysis ─────────────────────────────────────────────────────────────
# URL interna del servicio FastAPI (dentro de Docker Compose)
SAT_API_URL=http://sat-analysis:8001
NEXT_PUBLIC_SAT_API_URL=http://sat-analysis:8001
