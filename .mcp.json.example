{
  "mcpServers": {
    "vercel": {
      "command": "npx",
      "args": [
        "-y",
        "vercel-mcp",
        "VERCEL_API_KEY=${VERCEL_API_KEY}"
      ]
    },
    "hostinger-api": {
      "command": "hostinger-api-mcp",
      "env": {
        "DEBUG": "false",
        "API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    }
  }
}
